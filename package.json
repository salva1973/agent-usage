    "schema": "npm run build && node scripts/gen-schema.mjs"
  },
  "dependencies": { "zod": "^4" },
  "devDependencies": {
    "@types/node": "^22",
    "ajv": "^8",
    "ajv-formats": "^3",
    "typescript": "^5",
    "vitest": "~4.0.0"
  }
}
